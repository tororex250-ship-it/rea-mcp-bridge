{
  "name": "REA MCP Server Codespace",
  "image": "mcr.microsoft.com/devcontainers/universal:latest",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "REA MCP Server",
      "visibility": "public",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "npm install -g rea-agents@latest supergateway",
  "postStartCommand": "bash start.sh"
}
